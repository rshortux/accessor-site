---
import Logo from './Logo.astro';
import { useCaseCategories, resourceItems, NAV_INDUSTRY_CAP, SIGN_IN_HREF } from '../data/nav';

interface Props {
  /** 'partners' is kept for the partner pages and lights the Resources trigger. */
  active?: 'platform' | 'usecases' | 'pricing' | 'resources' | 'partners' | 'about' | '';
}
const { active = '' } = Astro.props;
const resourcesActive = active === 'resources' || active === 'partners';

/** One menu, three columns, every column visible at once. The industry column
 *  is capped and ends with the link to the full list. */
const columns = useCaseCategories.map((c) => {
  const capped = c.key === 'industry' && c.items.length > NAV_INDUSTRY_CAP;
  return { ...c, items: capped ? c.items.slice(0, NAV_INDUSTRY_CAP) : c.items, capped };
});
const allHref = '/use-cases';
const allLabel = 'All use cases';
---

<header class="nav">
  <nav class="nav__bar" aria-label="Primary">
    <a href="/" class="nav__brand">
      <Logo size={30} id="navMark" />
      <span>limena</span>
    </a>

    <button class="nav__burger" type="button" aria-expanded="false" aria-controls="nav-mobile" data-burger>
      <span class="nav__burgerBars" aria-hidden="true"></span>
      <span>Menu</span>
    </button>

    <div class="nav__items">
      <div class="nav__primary">
        <a href="/platform" class="nav__link" aria-current={active === 'platform' ? 'page' : undefined}>Platform</a>

        <div class="nav__menu" data-menu="usecases" data-all-href={allHref}>
          <button
            type="button"
            class="nav__trigger"
            aria-expanded="false"
            aria-haspopup="true"
            aria-controls="panel-usecases"
            aria-current={active === 'usecases' ? 'page' : undefined}
            data-trigger
          >
            Use cases
            <span class="nav__caret" aria-hidden="true">▾</span>
          </button>

          <div class="nav__panel nav__panel--wide" id="panel-usecases" data-panel hidden>
            <div class="nav__cols">
              {
                columns.map((c) => (
                  <div class="nav__col">
                    <h2 class="nav__colHead" id={`col-${c.key}`}>{c.label}</h2>
                    <ul class="nav__colList" aria-labelledby={`col-${c.key}`}>
                      {c.items.map((item) => (
                        <li>
                          <a href={item.href} class="nav__item">
                            <span class="nav__itemName">{item.name}</span>
                            <span class="nav__itemDesc">{item.desc}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                    {c.capped && (
                      <a href={allHref} class="nav__allLink">
                        {allLabel} →
                      </a>
                    )}
                  </div>
                ))
              }
            </div>
          </div>
        </div>

        <a href="/pricing" class="nav__link" aria-current={active === 'pricing' ? 'page' : undefined}>Pricing</a>

        <div class="nav__menu nav__menu--compact" data-menu="resources">
          <button
            type="button"
            class="nav__trigger"
            aria-expanded="false"
            aria-haspopup="true"
            aria-controls="panel-resources"
            aria-current={resourcesActive ? 'page' : undefined}
            data-trigger
          >
            Resources
            <span class="nav__caret" aria-hidden="true">▾</span>
          </button>

          <div class="nav__panel nav__panel--compact" id="panel-resources" data-panel hidden>
            <ul class="nav__colList nav__compactList" aria-label="Resources">
              {
                resourceItems.map((item) => (
                  <li>
                    <a href={item.href} class="nav__item">
                      <span class="nav__itemName">{item.name}</span>
                      <span class="nav__itemDesc">{item.desc}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <a href="/about" class="nav__link" aria-current={active === 'about' ? 'page' : undefined}>About</a>
      </div>

      <div class="nav__utility">
        <a href={SIGN_IN_HREF} class="nav__link nav__signin">Sign in</a>
        <a href="/contact" class="btn btn--primary nav__cta">Book a demo</a>
      </div>
    </div>
  </nav>

  <div class="nav__mobile" id="nav-mobile" hidden>
    <a href="/platform" class="nav__mobileTop">Platform</a>

    <section class="nav__mobileGroup" aria-labelledby="mobile-usecases">
      <h2 class="nav__mobileHead" id="mobile-usecases">Use cases</h2>
      {
        columns.map((c) => (
          <details class="nav__mobileCat">
            <summary class="nav__mobileCatSummary">
              <span>{c.label}</span>
              <span class="nav__mobileCatCount" aria-hidden="true">{c.items.length}</span>
            </summary>
            <ul class="nav__mobileList">
              {c.items.map((item) => (
                <li>
                  <a href={item.href} class="nav__mobileItem">
                    {item.name}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        ))
      }
      <a href={allHref} class="nav__allLink nav__mobileAll">{allLabel} →</a>
    </section>

    <a href="/pricing" class="nav__mobileTop">Pricing</a>

    <section class="nav__mobileGroup" aria-labelledby="mobile-resources">
      <h2 class="nav__mobileHead" id="mobile-resources">Resources</h2>
      <ul class="nav__mobileList nav__mobileList--flush">
        {
          resourceItems.map((item) => (
            <li>
              <a href={item.href} class="nav__mobileItem">
                {item.name}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <a href="/about" class="nav__mobileTop">About</a>
    <a href={SIGN_IN_HREF} class="nav__mobileTop">Sign in</a>
    <a href="/contact" class="btn btn--primary nav__mobileCta">Book a demo</a>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(244, 241, 234, 0.92);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .nav__bar {
    max-width: var(--content);
    margin: 0 auto;
    padding: 16px var(--gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .nav__brand {
    display: flex;
    align-items: center;
    gap: 11px;
    text-decoration: none;
    color: inherit;
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.025em;
  }

  .nav__items {
    position: relative;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-left: 28px;
  }

  .nav__primary,
  .nav__utility {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .nav__utility {
    margin-left: auto;
  }

  .nav__signin {
    color: var(--ink-700);
  }

  .nav__link,
  .nav__trigger {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 13px;
    font-family: var(--sans);
    font-size: 15px;
    font-weight: 500;
    color: var(--ink-500);
    background: transparent;
    border: none;
    border-radius: 8px;
    text-decoration: none;
    cursor: pointer;
  }

  .nav__link:hover,
  .nav__trigger:hover {
    color: var(--evergreen);
  }

  .nav__link[aria-current='page'],
  .nav__trigger[aria-current='page'] {
    font-weight: 600;
    color: var(--evergreen);
  }

  .nav__trigger[aria-expanded='true'] {
    background: rgba(22, 38, 28, 0.06);
  }

  .nav__caret {
    font-size: 11px;
    color: var(--muted);
    display: inline-block;
    transition: transform 160ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .nav__trigger[aria-expanded='true'] .nav__caret {
    transform: rotate(180deg);
  }

  .nav__cta {
    margin-left: 8px;
    height: 42px;
    padding: 0 20px;
  }

  .nav__menu {
    position: static;
  }

  .nav__menu--compact {
    position: relative;
  }

  /* Anchored to the right edge of the nav items, not centred under the
     trigger, so a wide panel never runs off the viewport near the breakpoint. */
  .nav__panel {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    width: max-content;
    max-width: calc(100vw - 32px);
    background: var(--white);
    border: 1px solid var(--border-strong);
    border-radius: var(--r-card);
    overflow: hidden;
    box-shadow: var(--shadow-pop);
    z-index: 60;
  }

  /* Bridges the 10px gap between trigger and panel so travelling the mouse
     down into the menu does not fire pointerleave and close it. */
  .nav__panel::before {
    content: '';
    position: absolute;
    top: -12px;
    left: 0;
    right: 0;
    height: 12px;
  }

  .nav__panel[hidden] {
    display: none;
  }

  .nav__panel--compact {
    right: auto;
    left: 0;
    width: 340px;
  }

  .nav__compactList {
    padding: 20px 22px;
  }

  .nav__cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0 40px;
    width: 960px;
    max-width: 100%;
    padding: 28px 32px 30px;
  }

  .nav__col {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .nav__colHead {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--green-hover);
    margin: 0 0 14px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--border);
  }

  .nav__colList {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .nav__allLink {
    font-size: 14px;
    font-weight: 600;
    color: var(--green-hover);
    text-decoration: none;
  }

  .nav__allLink:hover {
    color: var(--evergreen);
  }

  .nav__col > .nav__allLink {
    margin-top: 18px;
  }

  .nav__item {
    display: block;
    text-decoration: none;
  }

  .nav__item:hover {
    opacity: 0.7;
  }

  .nav__itemName {
    display: block;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--evergreen);
    margin-bottom: 3px;
  }

  .nav__itemDesc {
    display: block;
    font-size: 13.5px;
    line-height: 1.45;
    color: var(--ink-500);
  }

  /* ---------- Mobile ---------- */

  .nav__burger {
    display: none;
    align-items: center;
    gap: 10px;
    padding: 9px 15px;
    background: transparent;
    border: 1px solid var(--border-strong);
    border-radius: var(--r-control-sm);
    font-family: var(--sans);
    font-size: 15px;
    font-weight: 600;
    color: var(--evergreen);
    cursor: pointer;
  }

  .nav__burgerBars,
  .nav__burgerBars::before,
  .nav__burgerBars::after {
    display: block;
    width: 16px;
    height: 2px;
    background: var(--evergreen);
    border-radius: 2px;
  }

  .nav__burgerBars {
    position: relative;
  }

  .nav__burgerBars::before,
  .nav__burgerBars::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .nav__burgerBars::before {
    top: -5px;
  }
  .nav__burgerBars::after {
    top: 5px;
  }

  .nav__mobile {
    display: none;
  }

  @media (max-width: 1080px) {
    .nav__items {
      display: none;
    }

    .nav__burger {
      display: inline-flex;
    }

    .nav__mobile:not([hidden]) {
      display: block;
      max-height: calc(100vh - 74px);
      overflow-y: auto;
      padding: 8px 24px 32px;
      border-top: 1px solid var(--border);
      background: var(--paper);
    }

    .nav__mobileTop {
      display: block;
      padding: 14px 0;
      font-size: 18px;
      font-weight: 700;
      letter-spacing: -0.02em;
      text-decoration: none;
      border-bottom: 1px solid var(--border);
    }

    .nav__mobileGroup {
      padding: 14px 0 20px;
      border-bottom: 1px solid var(--border);
    }

    .nav__mobileHead {
      font-size: 18px;
      font-weight: 700;
      letter-spacing: -0.02em;
      margin: 0 0 6px;
    }

    .nav__mobileCat {
      border-top: 1px solid var(--border);
    }

    .nav__mobileCat:first-of-type {
      border-top: none;
    }

    .nav__mobileCatSummary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 12px 0;
      font-size: 16px;
      font-weight: 600;
      color: var(--ink-700);
      cursor: pointer;
      list-style: none;
    }

    .nav__mobileCatSummary::-webkit-details-marker {
      display: none;
    }

    .nav__mobileCatSummary::after {
      content: '+';
      font-size: 18px;
      line-height: 1;
      color: var(--muted);
    }

    .nav__mobileCat[open] > .nav__mobileCatSummary::after {
      content: '−';
    }

    .nav__mobileCatCount {
      margin-left: auto;
      font-family: var(--mono);
      font-size: 12px;
      color: var(--muted);
    }

    .nav__mobileList {
      list-style: none;
      margin: 0;
      padding: 0 0 10px 14px;
    }

    .nav__mobileItem {
      display: block;
      padding: 8px 0;
      font-size: 16px;
      color: var(--ink-700);
      text-decoration: none;
    }

    .nav__mobileList--flush {
      padding-left: 0;
      padding-bottom: 0;
    }

    .nav__mobileAll {
      display: inline-block;
      margin-top: 14px;
    }

    .nav__mobileCta {
      margin-top: 24px;
      width: 100%;
    }
  }
</style>

<script>
  const nav = document.querySelector('.nav');
  if (nav) {
    const menus = Array.from(nav.querySelectorAll<HTMLElement>('[data-menu]'));

    const closeAll = (except?: HTMLElement) => {
      for (const menu of menus) {
        if (menu === except) continue;
        menu.querySelector<HTMLButtonElement>('[data-trigger]')?.setAttribute('aria-expanded', 'false');
        menu.querySelector<HTMLElement>('[data-panel]')?.setAttribute('hidden', '');
      }
    };

    const setOpen = (menu: HTMLElement, open: boolean) => {
      const trigger = menu.querySelector<HTMLButtonElement>('[data-trigger]');
      const panel = menu.querySelector<HTMLElement>('[data-panel]');
      if (!trigger || !panel) return;
      trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
      panel.toggleAttribute('hidden', !open);
      if (open) closeAll(menu);
    };

    for (const menu of menus) {
      const trigger = menu.querySelector<HTMLButtonElement>('[data-trigger]')!;
      const allHref = menu.dataset.allHref;

      // Hover opens for mouse and pen. A click on a hover-opened trigger goes
      // to the hub instead of closing the menu the visitor just opened.
      // Keyboard and touch never see pointerenter, so click toggles for them.
      let openedByHover = false;

      menu.addEventListener('pointerenter', (e) => {
        if ((e as PointerEvent).pointerType === 'touch') return;
        openedByHover = true;
        setOpen(menu, true);
      });
      menu.addEventListener('pointerleave', (e) => {
        if ((e as PointerEvent).pointerType === 'touch') return;
        openedByHover = false;
        setOpen(menu, false);
      });

      trigger.addEventListener('click', () => {
        const isOpen = trigger.getAttribute('aria-expanded') === 'true';
        if (isOpen && openedByHover) {
          // Hover already opened it. Go to the hub if there is one; otherwise
          // leave the menu open rather than snapping it shut under the pointer.
          if (allHref) window.location.assign(allHref);
          return;
        }
        setOpen(menu, !isOpen);
      });

      // Escape closes and returns focus to the trigger; tabbing out closes too.
      menu.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        setOpen(menu, false);
        trigger.focus();
      });
      menu.addEventListener('focusout', (e) => {
        if (!menu.contains(e.relatedTarget as Node)) setOpen(menu, false);
      });
    }

    document.addEventListener('click', (e) => {
      if (!nav.contains(e.target as Node)) closeAll();
    });

    const burger = nav.querySelector<HTMLButtonElement>('[data-burger]');
    const mobile = document.getElementById('nav-mobile');
    burger?.addEventListener('click', () => {
      const open = burger.getAttribute('aria-expanded') !== 'true';
      burger.setAttribute('aria-expanded', open ? 'true' : 'false');
      mobile?.toggleAttribute('hidden', !open);
    });
  }
</script>
